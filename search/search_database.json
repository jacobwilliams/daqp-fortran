e (n) integer(kind=ip), intent(out) :: istat daqp_success or a negative status private  subroutine set_soft_weights (me, istat, rho_l, rho_u, w_l, w_u) Set individual weights of the soft constraints (one entry per constraint;\nzero selects rho_soft / w_soft ; an absent argument leaves that weight as it\nis). A violation s of the lower (upper) side of a soft constraint adds w_l*s + s**2/(2*rho_l) ( w_u*s + s**2/(2*rho_u) ) to the objective\n(in the units of the problem). Arguments Type Intent Optional Attributes Name class( daqp_type ), intent(inout) :: me integer(kind=ip), intent(out) :: istat daqp_success or a negative status real(kind=wp), intent(in), optional :: rho_l (:) reciprocal quadratic weights of the lower sides (m) real(kind=wp), intent(in), optional :: rho_u (:) reciprocal quadratic weights of the upper sides (m) real(kind=wp), intent(in), optional :: w_l (:) linear weights of the lower sides (m) real(kind=wp), intent(in), optional :: w_u (:) linear weights of the upper sides (m) private  subroutine info (me, status, iter, outer_iter, fval, soft_slack, n_active, solve_time, setup_time) Information on the latest solve. Arguments Type Intent Optional Attributes Name class( daqp_type ), intent(in) :: me integer(kind=ip), intent(out), optional :: status status of the latest call integer(kind=ip), intent(out), optional :: iter iterations integer(kind=ip), intent(out), optional :: outer_iter nodes (branch and bound), or outer iterations real(kind=wp), intent(out), optional :: fval objective function value real(kind=wp), intent(out), optional :: soft_slack largest violation of a soft constraint integer(kind=ip), intent(out), optional :: n_active number of active constraints real(kind=wp), intent(out), optional :: solve_time time of the latest solve [s] real(kind=wp), intent(out), optional :: setup_time time of the latest setup [s] private  subroutine destroy (me) Free the memory (the options are kept). Arguments Type Intent Optional Attributes Name class( daqp_