aqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function eq_same_candidates ( work ) type ( daqp_workspace ), intent ( in ) :: work !! workspace integer ( ip ) :: i , k eq_same_candidates = . false . k = 0 do i = work % qp % ms + 1 , work % qp % m if (. not . eq_is_candidate ( work , i )) cycle if ( k == work % eq % ncand ) return if ( work % eq % cand_ids ( k + 1 ) /= i ) return k = k + 1 end do eq_same_candidates = k == work % eq % ncand end function eq_same_candidates","tags":"","url":"proc/eq_same_candidates.html"},{"title":"eq_is_symmetric – daqp-fortran","text":"private pure function eq_is_symmetric(qp, zero_tol) Whether H is symmetric (for an AVI). Arguments Type Intent Optional Attributes Name type( daqp_problem ), intent(in) :: qp the problem real(kind=wp), intent(in) :: zero_tol tolerance Return Value logical Called by proc~~eq_is_symmetric~~CalledByGraph proc~eq_is_symmetric eq_is_symmetric proc~eq_build_reduction eq_build_reduction proc~eq_build_reduction->proc~eq_is_symmetric proc~daqp_eq_update daqp_eq_update proc~daqp_eq_update->proc~eq_build_reduction proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~daqp_eq_update proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure logical function eq_is_symmetric ( qp , zero_tol ) type ( daqp_problem ), intent ( in ) :: qp !! the problem real ( wp ), intent ( in ) :: zero_tol !! tolerance integer ( ip ) :: i , j real ( wp ) :: scale , d , diff scale = 0.0_wp do i = 1 , qp % n d = qp % Hc ( i , i ) if ( d < 0.0_wp ) d = - d if ( d > scale ) scale = d end do if ( scale < 1.0_wp ) scale = 1.0_wp eq_is_symmetric = . false . do i = 1 , qp % n do j = i + 1 , qp % n diff = qp % Hc ( j , i ) - qp % Hc ( i , j ) if ( diff > zero_tol * scale . or . diff < - zero_tol * scale ) return end do end do eq_is_symmetric = . true . end function eq_is_symmetric","tags":"","url":"proc/eq_is_symmetric.html"},{"title":"eq_split_flat – daqp-fortran","text":"private  function eq_split_flat(qp, Z, n, nz, cid, nc, zero_tol, Hr) result(r) Split Z ( n x nz ) into [Z1 Z2] , with Z2 zero in the rows cid (the\nvariables with curvature), so that H*Z2 = 0 exactly. Forms Hr = blockdiag(Z1'HZ1, 0) and returns the dimension of Z1 . Arguments Type Intent Optional Attributes Name type( daqp_problem ), intent(in) :: qp the problem real(kind=wp), intent(inout) :: Z (:,:) null-space basis (columns) integer(kind=ip), intent(in) :: n number of variables integer(kind=ip), intent(in) :: nz dimension of the null space integer(kind=ip), intent(in) :: cid (:) variables with curvature integer(kind=ip), intent(in) :: nc number of them real(kind=wp), intent(in) :: zero_tol tolerance real(kind=wp), intent(inout) :: Hr (:,:) reduced Hessian Return Value integer(kind=ip) Calls proc~~eq_split_flat~~CallsGraph proc~eq_split_flat eq_split_flat proc~eq_apply_qt_many eq_apply_QT_many proc~eq_split_flat->proc~eq_apply_qt_many proc~eq_reflect eq_reflect proc~eq_split_flat->proc~eq_reflect proc~eq_apply_qt_many->proc~eq_reflect Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~eq_split_flat~~CalledByGraph proc~eq_split_flat eq_split_flat proc~eq_build_reduction eq_build_reduction proc~eq_build_reduction->proc~eq_split_flat proc~daqp_eq_update daqp_eq_update proc~daqp_eq_update->proc~eq_build_reduction proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~daqp_eq_update proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code integer ( ip ) function eq_split_flat ( qp , Z , n , nz , cid , nc , zero_tol , Hr ) result ( r ) type ( daqp_problem ), intent ( in ) :: qp !! the problem real ( wp ), intent ( inout ) :: Z (:,:) !! null-space basis (columns) integer ( ip ), intent ( in ) :: n !! number of variables integer ( ip ), intent ( in ) :: nz !! dimension of the null space integer ( ip ), intent ( in ) :: cid (:) !! variables with curvature integer ( ip ), intent ( in ) :: nc !! number of them real ( wp ), intent ( in ) :: zero_tol !! tolerance real ( wp ), intent ( inout ) :: Hr (:,:) !! reduced Hessian real ( wp ), allocatable :: Y (:,:), tau (:), Zr (:,:), G (:,:) real ( wp ) :: tol , alpha , beta , d , sm integer ( ip ) :: i , j , k , c tol = sqrt ( zero_tol ) allocate ( Y ( nz , max ( 1_ip , nc )), tau ( nc + 1 ), Zr ( nz , n )) Y = 0.0_wp tau = 0.0_wp r = 0 ! Householder QR of Z_C' (the rows cid of Z), with its rank r do c = 1 , nc if ( r >= nz ) exit do j = 1 , nz Y ( j , r + 1 ) = Z ( cid ( c ), j ) end do do k = 1 , r call eq_reflect ( Y (:, k ), tau ( k ), k , nz , Y (:, r + 1 )) end do alpha = 0.0_wp do j = r + 1 , nz alpha = alpha + Y ( j , r + 1 ) * Y ( j , r + 1 ) end do alpha = sqrt ( alpha ) if ( alpha <= tol ) cycle ! dependent on the rows before if ( Y ( r + 1 , r + 1 ) > 0.0_wp ) then beta = - alpha else beta = alpha end if d = Y ( r + 1 , r + 1 ) - beta tau ( r + 1 ) = - d / beta do j = r + 2 , nz Y ( j , r + 1 ) = Y ( j , r + 1 ) / d end do Y ( r + 1 , r + 1 ) = beta r = r + 1 end do ! Z <-- Z Q: rows (Q'z')', the last nz-r columns are Z2 do i = 1 , n do j = 1 , nz Zr ( j , i ) = Z ( i , j ) end do end do call eq_apply_QT_many ( Y , tau , r , nz , Zr , n ) do c = 1 , nc do j = r + 1 , nz Zr ( j , cid ( c )) = 0.0_wp ! roundoff end do end do do i = 1 , n do j = 1 , nz Z ( i , j ) = Zr ( j , i ) end do end do ! Hr = blockdiag(Z1_C' H_CC Z1_C, 0), with G = H_CC Z1_C Hr ( 1 : nz , 1 : nz ) = 0.0_wp allocate ( G ( max ( 1_ip , r ), max ( 1_ip , nc ))) do c = 1 , nc do j = 1 , r sm = 0.0_wp do k = 1 , nc sm = sm + qp % Hc ( cid ( k ), cid ( c )) * Zr ( j , cid ( k )) end do G ( j , c ) = sm end do end do do i = 1 , r do j = i , r sm = 0.0_wp do c = 1 , nc sm = sm + Zr ( i , cid ( c )) * G ( j , c ) end do Hr ( j , i ) = sm Hr ( i , j ) = sm end do end do end function eq_split_flat","tags":"","url":"proc/eq_split_flat.html"},{"title":"eq_build_reduction – daqp-fortran","text":"private  function eq_build_reduction(work) result(flag) Form the reduction of the problem in the workspace: the factorizations, the\nreduced constraints and the storage of the reduced problem. Returns 0 if\nnothing can be eliminated, or if a soft constraint would be left out. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) Calls proc~~eq_build_reduction~~CallsGraph proc~eq_build_reduction eq_build_reduction proc~eq_accumulate_z eq_accumulate_Z proc~eq_build_reduction->proc~eq_accumulate_z proc~eq_allocate_reduced_ldp eq_allocate_reduced_ldp proc~eq_build_reduction->proc~eq_allocate_reduced_ldp proc~eq_allocate_reduction eq_allocate_reduction proc~eq_build_reduction->proc~eq_allocate_reduction proc~eq_apply_qt_many eq_apply_QT_many proc~eq_build_reduction->proc~eq_apply_qt_many proc~eq_build_qr eq_build_qr proc~eq_build_reduction->proc~eq_build_qr proc~eq_chol eq_chol proc~eq_build_reduction->proc~eq_chol proc~eq_dot eq_dot proc~eq_build_reduction->proc~eq_dot proc~eq_free_rhs_cache eq_free_rhs_cache