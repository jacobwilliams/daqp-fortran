d subroutine invert_R","tags":"","url":"proc/invert_r.html"},{"title":"transform_v – daqp-fortran","text":"private  subroutine transform_v(work, v) y <-- R'&#94;{-1}... : transform a linear term in place, v = Rinv'*f (upstream's daqp_update_v , with f given in v ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace real(kind=wp), intent(inout) :: v (:) f on input, v on output (size n ) Calls proc~~transform_v~~CallsGraph proc~transform_v transform_v proc~has~2 has proc~transform_v->proc~has~2 proc~ridx~2 ridx proc~transform_v->proc~ridx~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~transform_v~~CalledByGraph proc~transform_v transform_v proc~daqp_prox daqp_prox proc~daqp_prox->proc~transform_v proc~prox_project_step prox_project_step proc~daqp_prox->proc~prox_project_step proc~prox_step prox_step proc~daqp_prox->proc~prox_step proc~daqp_solve_avi daqp_solve_avi proc~daqp_solve_avi->proc~transform_v proc~daqp_solve_avi->proc~daqp_solve_avi proc~retry_avi_with_reduced_rho retry_avi_with_reduced_rho proc~daqp_solve_avi->proc~retry_avi_with_reduced_rho proc~prox_project_step->proc~transform_v proc~update_v update_v proc~update_v->proc~transform_v proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_prox proc~daqp_solve->proc~daqp_solve_avi proc~daqp_update_ldp daqp_update_ldp proc~daqp_solve->proc~daqp_update_ldp proc~prox_step->proc~prox_project_step proc~retry_avi_with_reduced_rho->proc~update_v proc~update_ldp_core update_ldp_core proc~update_ldp_core->proc~update_v proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_solve proc~daqp_setup daqp_setup proc~daqp_quadprog->proc~daqp_setup proc~daqp_update_ldp->proc~update_ldp_core proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog proc~daqp_setup->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~setup daqp_type%setup proc~setup->proc~daqp_setup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine transform_v ( work , v ) type ( daqp_workspace ), intent ( in ) :: work !! workspace real ( wp ), intent ( inout ) :: v (:) !! `f` on input, `v` on output (size `n`) integer ( ip ) :: i , j , n , stop_id , dj real ( wp ) :: fj n = work % n if ( work % rmode /= rinv_dense ) then ! Rinv = I (or diagonal) if ( work % rmode == rinv_diag ) then do i = 1 , n v ( i ) = v ( i ) * work % R ( i ) end do end if return end if stop_id = 0 if ( has ( work % state , state_rinv_normalized )) stop_id = work % ms do j = n , 1 , - 1 dj = ridx ( j , j , n ) if ( j > stop_id ) then fj = v ( j ) else ! take the scaling in Rinv into account fj = v ( j ) / work % scaling ( j ) end if do i = n , j + 1 , - 1 v ( i ) = v ( i ) + work % R ( dj + i - j ) * fj end do v ( j ) = work % R ( dj ) * fj end do end subroutine transform_v","tags":"","url":"proc/transform_v.html"},{"title":"update_v – daqp-fortran","text"