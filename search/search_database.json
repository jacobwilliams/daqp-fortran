ed for constraints ! that are omitted from the normalized LDP work % scaling ( i ) = 1.0_wp if ( work % qp % bupper ( i ) < - zero_tol . or . work % qp % blower ( i ) > zero_tol ) then if ( iand ( work % sense ( i ), daqp_immutable + daqp_active ) /= daqp_immutable . and . & . not . has ( work % sense ( i ), daqp_soft )) then flag = daqp_exit_infeasible return end if end if work % sense ( i ) = daqp_immutable ! ignore a zero-row constraint cycle end if scaling_i = 1.0_wp / sqrt ( scaling_i ) work % scaling ( i ) = scaling_i do j = 1 , n work % Mr ( j , k ) = work % Mr ( j , k ) * scaling_i end do end do end function normalize_M","tags":"","url":"proc/normalize_m.html"},{"title":"check_unconstrained – daqp-fortran","text":"private  function check_unconstrained(work, mask) result(flag) Check whether the unconstrained optimum is feasible (and hence the solution). Returns 0 if the unconstrained optimum was not computed, 1 if it was, but is\nnot optimal ( d is then formed, unscaled), and unconstrained_optimal if it is\nthe solution (in x ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: mask update mask Return Value integer(kind=ip) Calls proc~~check_unconstrained~~CallsGraph proc~check_unconstrained check_unconstrained proc~daqp_lu_solve daqp_lu_solve proc~check_unconstrained->proc~daqp_lu_solve proc~daqp_reset_workspace daqp_reset_workspace proc~check_unconstrained->proc~daqp_reset_workspace proc~dot_seq dot_seq proc~check_unconstrained->proc~dot_seq proc~has~2 has proc~check_unconstrained->proc~has~2 proc~is_avi_nonsym is_avi_nonsym proc~check_unconstrained->proc~is_avi_nonsym proc~is_hierarchical is_hierarchical proc~check_unconstrained->proc~is_hierarchical proc~swap_x swap_x proc~check_unconstrained->proc~swap_x proc~unconstrained_cholesky unconstrained_cholesky proc~check_unconstrained->proc~unconstrained_cholesky proc~ridx~2 ridx proc~unconstrained_cholesky->proc~ridx~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~check_unconstrained~~CalledByGraph proc~check_unconstrained check_unconstrained proc~update_ldp_core update_ldp_core proc~update_ldp_core->proc~check_unconstrained proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~update_ldp_core proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code integer ( ip ) function check_unconstrained ( work , mask ) result ( flag ) type ( daqp_workspace ), intent ( inout ) :: work !! workspace integer ( ip ), intent ( in ) :: mask !! update mask integer ( ip ) :: i , j , k , n real ( wp ) :: s , primal_tol logical :: feasible flag = 0 if (. not . has ( mask , daqp_update_unconstrained )) return if ( iand ( mask , daqp_update_rinv + daqp_update_m + daqp_update_v + daqp_update_d ) == 0 ) return ! not a standard QP/AVI if ( allocated ( work % bnb ) . or . is_hierarchical ( work ) . or . work % n_prox > 0 ) return do i = 1 , work % m ! no equalities if ( iand ( work % sense ( i ), daqp_active + daqp_immutable ) /= 0 ) return end do n = work % n primal_tol = work % settings % primal_tol feasible = . true . ! compute x_unc, temporarily in x call swap_x ( work ) if ( has ( work % state , state_cholesky_pending )) then ! form v only when checking the candidate: R'v = f, then R x = -v if ( work % has_v ) then call unconstrained_cholesky ( work , work % v , feasible ) else call unconstrained_cholesky ( work , work % xldl , feasible ) end if else if ( is_avi_nonsym ( work )) then ! AVI: the unconstrained solution is x = -H&#94;{-1} f if ( work % qp % has_f ) then call daqp_lu_solve ( work % avi % LU_H , work % avi % P_H , work % qp % f , work % x , n ) else work % x ( 1 : n ) = 0.0_wp end if do i = 1 , n work % x ( i ) = - work % x ( i ) end do else if ( work % has_v ) then select case ( work % rmode ) case ( rinv_dense ) k = 1 do i = 1 , n s = 0.0_wp do j = i , n s = s + work % R ( k ) * work % v ( j ) k = k + 1 end do work % x ( i ) = - s end do if ( has ( work % state , state_rinv_normalized )) then do i = 1 , work % ms work % x ( i ) = work % x ( i ) / work % scaling ( i ) end do end if case ( rinv_diag ) do i = 1 , n work % x ( i ) = - work % R ( i ) * work % v ( i ) end do case default do i = 1 , n work % x ( i ) = - work % v ( i ) end do end select else work % x ( 1 : n ) = 0.0_wp ! no linear term: the unconstrained optimum is x = 0 end if ! check the simple bounds do i = 1 , work % ms work % dupper ( i ) = work % qp % bupper ( i ) - work % x ( i ) work % dlower ( i ) = work % qp % blower ( i ) - work % x ( i ) if ( work % dupper ( i ) < - primal_tol . or . work % dlower ( i ) > primal_tol ) feasible = . false . end do ! check the general constraints do i = work % ms + 1 , work % m s = dot_seq ( n , work % qp % At (:, i - work % ms ), work % x ) work % dupper ( i ) = work % qp % bupper ( i ) - s work % dlower ( i ) = work % qp % blower ( i ) - s if ( work % dupper ( i ) < - primal_tol . or . work % dlower ( i ) > primal_tol ) feasible = . false . end do if ( feasible ) then call daqp_reset_workspace ( work ) work % state = ior ( work % state , state_unconstrained ) flag = unconstrained_optimal return end if ! switch back, so that a warm start is preserved call swap_x ( work ) flag = 1 end function check_unconstrained","tags":"","url":"proc/check_unconstrained.html"},{"title":"update_ldp_core – daqp-fortran","text":"private  function update_ldp_core(mask_in, work) result(flag) Form the LDP of the problem that is in the workspace (the reduced problem\nof an equality elimination is passed here as it is), as marked by mask_in . Returns 0, or a negative exit flag. Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: mask_in the parts to update ( daqp_update_* ) type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) Calls proc~~update_ldp_core~~CallsGraph proc~update_ldp_core update_ldp_core proc~check_bounds check_bounds proc~update_ldp_core->proc~check_bounds proc~check_unconstrained check_unconstrained proc~update_ldp_core->proc~check_unconstrained proc~daqp_activate_constraints daqp_activate_constraints proc~update_ldp_core->proc~daqp_activate_constraints proc~daqp_lu daqp_lu proc~update_ldp_core->proc~daqp_lu proc~daqp_reset_workspace daqp_reset_workspace proc~update_ldp_core->proc~daqp_reset_workspace proc~finish_rinv_qp finish_Rinv_qp proc~update_ldp_core->proc~finish_rinv_qp proc~has~2 has proc~update_ldp_core->proc~has~2 proc~is_avi_nonsym is_avi_nonsym proc~update