e. Source Code logical function daqp_set_soft_weights ( work , rho_l , rho_u , w_l , w_u ) type ( daqp_workspace ), intent ( inout ) :: work !! workspace real ( wp ), intent ( in ), optional :: rho_l (:) !! reciprocal quadratic weight of the lower side real ( wp ), intent ( in ), optional :: rho_u (:) !! reciprocal quadratic weight of the upper side real ( wp ), intent ( in ), optional :: w_l (:) !! linear weight of the lower side real ( wp ), intent ( in ), optional :: w_u (:) !! linear weight of the upper side integer ( ip ) :: m daqp_set_soft_weights = daqp_allocate_soft_weights ( work ) if (. not . daqp_set_soft_weights ) return m = size ( work % rho_ls ) if ( present ( rho_l )) work % rho_ls ( 1 : m ) = rho_l ( 1 : m ) if ( present ( rho_u )) work % rho_us ( 1 : m ) = rho_u ( 1 : m ) if ( present ( w_l )) work % w_ls ( 1 : m ) = w_l ( 1 : m ) if ( present ( w_u )) work % w_us ( 1 : m ) = w_u ( 1 : m ) call daqp_refresh_soft_weights ( work ) end function daqp_set_soft_weights","tags":"","url":"proc/daqp_set_soft_weights.html"},{"title":"daqp_first_violating – daqp-fortran","text":"public  function daqp_first_violating(x, A, bu, bl, ms, tol) result(ind) The first constraint that x violates by more than tol (upstream's daqp_first_violating ), or m+1 if none. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: x (:) point (n) real(kind=wp), intent(in) :: A (:,:) general constraints (m-ms,n) real(kind=wp), intent(in) :: bu (:) upper bounds (m) real(kind=wp), intent(in) :: bl (:) lower bounds (m) integer(kind=ip), intent(in) :: ms number of simple bounds real(kind=wp), intent(in) :: tol tolerance Return Value integer(kind=ip) Source Code integer ( ip ) function daqp_first_violating ( x , A , bu , bl , ms , tol ) result ( ind ) real ( wp ), intent ( in ) :: x (:) !! point `(n)` real ( wp ), intent ( in ) :: A (:,:) !! general constraints `(m-ms,n)` real ( wp ), intent ( in ) :: bu (:) !! upper bounds `(m)` real ( wp ), intent ( in ) :: bl (:) !! lower bounds `(m)` integer ( ip ), intent ( in ) :: ms !! number of simple bounds real ( wp ), intent ( in ) :: tol !! tolerance integer ( ip ) :: i , j , m , n real ( wp ) :: ax m = int ( size ( bu ), ip ) n = int ( size ( x ), ip ) do i = 1 , ms if ( x ( i ) > bu ( i ) + tol . or . x ( i ) < bl ( i ) - tol ) then ind = i return end if end do do i = ms + 1 , m ax = 0.0_wp do j = 1 , n ax = ax + A ( i - ms , j ) * x ( j ) end do if ( ax > bu ( i ) + tol . or . ax < bl ( i ) - tol ) then ind = i return end if end do ind = m + 1 ! no constraint is violated end function daqp_first_violating","tags":"","url":"proc/daqp_first_violating.html"},{"title":"daqp_lu – daqp-fortran","text":"private  function daqp_lu(A, P, n) result(flag) LU factorization with partial pivoting, in place, of the n x n row-major\nmatrix A ( A(j*n+i+1) is element (j,i) , 0-based). Returns 0, or -1 if\na pivot is below 1e-12 (upstream's daqp_lu ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: A (*) matrix; factors on output integer(kind=ip), intent(inout) :: P (*) permutation (1-based) integer(kind=ip), intent(in) :: n dimension Return Value integer(kind=ip) Called by proc~~daqp_lu~~CalledByGraph proc~daqp_lu daqp_lu proc~daqp_solve_avi_kkt daqp_solve_avi_kkt proc~daqp_solve_avi_kkt->proc~daqp_lu proc~retry_avi_with_reduced_rho retry_avi_with_reduced_rho proc~retry_avi_with_reduced_rho->proc~daqp_lu proc~update_avi update_avi proc~update_avi->proc~daqp_lu proc~update_ldp_core update_ldp_core proc~update_ldp_core->proc~daqp_lu proc~update_ldp_core->proc~update_avi proc~daqp_solve_avi daqp_solve_avi proc~daqp_solve_avi->proc~daqp_solve_avi_kkt proc~daqp_solve_avi->proc~retry_avi_with_reduced_rho proc~daqp_solve_avi->proc~daqp_solve_avi proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~update_ldp_core proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_solve_avi proc~daqp_solve->proc~daqp