er(kind=ip), intent(in) :: m number of constraints (including the simple bounds) integer(kind=ip), intent(in) :: ms number of simple bounds real(kind=wp), intent(in) :: bupper (m) upper bounds real(kind=wp), intent(in) :: blower (m) lower bounds real(kind=wp), intent(in), optional :: H (n,n) Hessian (absent: an LP) real(kind=wp), intent(in), optional :: f (n) linear term real(kind=wp), intent(in), optional :: A (m-ms,n) constraint matrix (absent if m == ms ) integer(kind=ip), intent(in), optional :: sense (m) constraint flags integer(kind=ip), intent(in), optional :: init_mask extra update mask ( daqp_update_unconstrained , daqp_update_eliminate ) real(kind=wp), intent(in), optional :: At (n,m-ms) the transpose of A (instead of A ) integer(kind=ip), intent(in), optional :: break_points (:) the last constraint of each level (hierarchical QP) integer(kind=ip), intent(in), optional :: problem_type daqp_problem_qp (default) or daqp_problem_avi real(kind=wp), intent(in), optional :: Rf (:) the Cholesky factor of H , packed by rows (instead of H ) real(kind=wp), intent(in), optional :: primal_start (n) a primal start (its active constraints start the working set) real(kind=wp), intent(in), optional :: dual_start (m) a dual start (its nonzero multipliers start the working set) real(kind=wp), intent(out), optional :: setup_time time of the setup [s] Return Value integer(kind=ip) public  function daqp_set_working_set (work, active, at_lower) result(flag) Set the working set for a warm start: the constraints active (at their\nlower bound where at_lower ). Equality (immutable) constraints are kept.\nReturns 1, or daqp_exit_overdetermined_initial . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: active (:) indices of the active constraints logical, intent(in) :: at_lower (:) whether each is active at its lower bound Return Value integer(kind=ip) public  function daqp_allocate_soft_weights (work) Allocate the individual weights of the soft constraints (zero, which selects\nthe settings). Returns false if there are no constraints. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value logical public  function daqp_set_soft_weights (work, rho_l, rho_u, w_l, w_u) Set the weights of the soft constraints, one entry per constraint of the\noriginal problem (an absent argument leaves that weight untouched; a zero\nweight selects the settings). A violation s of a soft constraint adds w*s + s&#94;2/(2*rho) to the objective. Returns false if they could not be\nallocated. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(in), optional :: rho_l (:) reciprocal quadratic weight of the lower side real(kind=wp), intent(in), optional :: rho_u (:) reciprocal quadratic weight of the upper side real(kind=wp), intent(in), optional :: w_l (:) linear weight of the lower side real(kind=wp), intent(in), optional :: w_u (:) linear weight of the upper side Return Value logical public  function daqp_first_violating (x, A, bu, bl, ms, tol) result(ind) The first constraint that x violates by more than tol (upstream's daqp_first_violating ), or m+1 if none. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: x (:) point (n) real(kind=wp), intent(in) :: A (:,:) general constraints (m-ms,n) real(kind=wp), intent(in) :: bu (:) upper bounds (m) real(kind=wp), intent(in) :: bl (:) lower bounds (m) integer(kind=ip), intent(in) :: ms number of simple bounds real(kind=wp), intent(in) :: tol tolerance Return Value integer(kind=ip) private  function daqp_lu (A, P, n) result(flag) LU factorization with partial pivoting, in place, of the n x n row-major\nmatrix A ( A(j*n+i+1) is element (j,i) , 0-based). Returns 0, or -1 if\na pivot is below 1e-12 (upstream's daqp_lu ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: A (*) matrix; factors on output integer(kind=ip), intent(inout) :: P (*) permutation (1-based) integer(kind=ip), intent(in) :: n dimension Return Value integer(kind=ip) private  function retry_avi_with_reduced_rho (work) result(flag) Retry an AVI with a reduced rho (upstream's daqp_retry_avi_with_reduced_rho ). Returns 0 if no retry is needed, 1, or\na negative exit flag. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) public recursive function daqp_solve_avi (work) result(exitflag) Solve a nonsymmetric AVI (upstream's daqp_solve_avi ): Douglas-Rachford\nsplitting, with each step an LDP of the symmetric part, and Newton steps\n(a KKT solve on the working set) when the working set settles. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) private  function daqp_check_optimal_avi (work) Whether the KKT point of an AVI is optimal (upstream's daqp_check_optimal_avi ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace Return Value logical private pure function add_lower_flag (x) Branch-and-bound constraint id helpers: the bit bnb_lower_bit marks the\nlower bound. Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: x constraint id Return Value integer(kind=ip) private pure function remove_lower_flag (x) Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: x constraint id Return Value integer(kind=ip) private pure function toggle_lower_flag (x) Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: x constraint id Return Value integer(kind=ip) private pure function extract_lower_flag (x) Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: x constraint id Return Value logical private  function binary_diff (work, id) result(diff) Signed distance of binary constraint id from the midpoint of its bounds. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace integer(kind=ip), intent(in) :: id constraint Return Value real(kind=wp) private  function bnb_store_ws (work, ids) result(n_ids) Store the free part of the working set in ids . Returns the number stored. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace integer(kind=ip), intent(inout) :: ids (:) storage Return Value integer(kind=ip) private  function bnb_setup_root (work) result(flag) The immutable constraints (e.g., equalities) are kept fixed as a prefix of\nthe working set throughout the tree. Returns the length of that prefix. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) private  function bnb_incumbent (work) result(fval) Use the candidate in x as an incumbent. Returns its objective (internal\nscale), with u = R*x+v stored in xold , or -1 if it is infeasible. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value real(kind=wp) public  function daqp_bnb (work) result(exitflag) Branch and bound over the binary constraints (upstream's daqp_bnb ).\nReturns the exit flag; x ( u ) holds the best solution. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Return Value integer(kind=ip) private  function process_node (work, node) result(exitflag) Solve the relaxation of a node (upstream's daqp_process_node ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: node node (index in the tree) Return Value integer(kind=ip) private  function get_branch_id (work) result(branch) The binary constraint to branch over (with the lower-bound bit for the\nlower endpoint), or empty_ind if the relaxation is integer feasible. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace Return Value integer(kind=ip) public  function daqp_hiqp (work, lam) result(exitflag) Solve a hierarchical (lexicographic) QP (upstream's daqp_hiqp ): the first\nlevel is hard; each following level is soft, and is made hard at the slacks\nit ends up with. lam (if present) is set to the slacks of the soft levels. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(inout), optional :: lam (:) slacks of the soft levels Return Value integer(kind=ip) Subroutines private  subroutine swap_x (work) Exchange x and xold (no copy). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine swap_lam (work) Exchange lam and lam_star (no copy). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine update_LDL_add (work, add_ind, rho) Add constraint add_ind to the LDL' factors of the working set\n(upstream's daqp_update_LDL_add ). A nonzero rho marks a free soft\nslack, and is added to the diagonal. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: add_ind constraint to add real(kind=wp), intent(in) :: rho reciprocal soft weight (or 0) private  subroutine update_LDL_remove (work, rm_ind) Remove the constraint at position rm_ind from the LDL' factors\n(upstream's daqp_update_LDL_remove : algorithm C1 of Gill et al., 1974). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: rm_ind position in the working set private recursive subroutine remove_constraint (work, rm_ind) Remove the constraint at working set position rm_ind . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: rm_ind working set position private recursive subroutine add_constraint_keep_slack (work, add_ind, lam) Add a constraint, keeping the slack state that is marked in sense . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: add_ind constraint real(kind=wp), intent(in) :: lam its multiplier private recursive subroutine add_constraint (work, add_ind, lam_in) Add a constraint to the working set (upstream's daqp_add_constraint ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: add_ind constraint real(kind=wp), intent(in) :: lam_in its multiplier private  subroutine compute_primal_and_fval (work) Compute u = -M_W'lam_star and fval = ||u||&#94;2 (plus the soft penalties). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine compute_Mu (work) Compute Mu = M'u for all the general constraints (four rows at a time). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine compute_CSP (work) Compute the constrained stationary point lam_star (solve M_W M_W' lam_star = -d_W with the LDL' factors). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine compute_singular_direction (work) The direction of a singular working set (stored in lam_star ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private recursive subroutine pivot_last (work) Swap the last two constraints of the working set if the next to last pivot is small. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine activate_constraint (work, id) Add constraint id to the working set, with a multiplier that reproduces\nthe slack state that is marked in sense . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: id constraint public  subroutine daqp_deactivate_constraints (work) Deactivate all the active constraints that are mutable (i.e., not equalities). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine solve_working_set (work) Solve L D L' dlam = r ( r and dlam in xldl , zldl is used as scratch). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine sub_working_set_rows (work, dlam, y) y <-- y - M_W'*dlam for the working set W .\n( y and dlam may be components of work that this routine does not\notherwise reference.) Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace real(kind=wp), intent(in) :: dlam (:) multipliers of the working set real(kind=wp), intent(inout) :: y (:) vector of size n private  subroutine refine_active (work) One step of iterative refinement for the active constraints: solve LDL' dlam = r with the residuals r = M_W u - d_W , and update lam_star += dlam , u -= M_W' dlam . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine apply_Rinv (work, y) y <-- Rinv*y (as daqp_ldp2qp_solution , without v ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace real(kind=wp), intent(inout) :: y (:) vector of size n private  subroutine refine_primal (work) One step of iterative refinement of x on the active constraints, done\ndirectly in x to avoid the cancellation in x = Rinv*(u-v) . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace public  subroutine daqp_ldp2qp_solution (work) Compute the QP solution x = Rinv*(u-v) from the LDP solution, and scale\nthe multipliers back. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine invert_R (work) Invert the packed factor R in place. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine transform_v (work, v) y <-- R'&#94;{-1}... : transform a linear term in place, v = Rinv'*f (upstream's daqp_update_v , with f given in v ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace real(kind=wp), intent(inout) :: v (:) f on input, v on output (size n ) private  subroutine update_v (work) Form v = Rinv'*f (upstream's daqp_update_v(qp->f, work) ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine rinv_product_block (work, k0, nb) Mr(:,k0:k0+nb-1) <-- Rinv'*Mr(:,k0:k0+nb-1) in place, for nb <= 4 rows of A (upstream's daqp_rinv_product_block ): the columns of Rinv are taken\nin pairs, in descending order, and each element is summed from its diagonal\nterm downwards, as upstream does. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: k0 first row of A (column of Mr ) integer(kind=ip), intent(in) :: nb number of rows (1 to 4) private  subroutine update_d (work) Form d = b + M*v (scaled). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine normalize_Rinv (work) Normalize the rows of Rinv of the simple bounds. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine unconstrained_cholesky (work, vs, feasible) Solve R'v = f , R x = -v with the factor R (reciprocal diagonal), for\nthe unconstrained optimum while the inverse is deferred. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(inout) :: vs (:) scratch for v (size n ) logical, intent(inout) :: feasible set to false if x is not finite private  subroutine prox_rescale (work, eps, eps_new) Change eps of the semi-proximal directions to eps_new (only their\ncolumns of Rinv and M are scaled; the working set has to be refactored\nafterwards). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(in) :: eps current regularization real(kind=wp), intent(in) :: eps_new new regularization public  subroutine daqp_destroy (work) Deallocate the workspace (the settings are kept). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine transpose_into (A, B) B = A' (blocked, to limit the strided accesses). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: A (:,:) (p,q) real(kind=wp), intent(out) :: B (:,:) (q,p) public  subroutine daqp_refresh_soft_weights (work) Refactor the working set after a change of the weights of the soft\nconstraints (upstream's daqp_refresh_soft_weights ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine extract_result (work, x, res, lam) Package the result (upstream's daqp_extract_result ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(inout) :: x (:) the solution type( daqp_result ), intent(inout) :: res result real(kind=wp), intent(inout), optional :: lam (:) multipliers public  subroutine daqp_extract_active_duals (work, lam) The multipliers of the working set, as they are (upstream's daqp_extract_active_duals ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace real(kind=wp), intent(out) :: lam (:) multipliers (size m ) public  subroutine daqp_solve (work, x, res, lam) Solve the problem from the current working set (upstream's daqp_solve ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(out) :: x (:) the solution (size n ) type( daqp_result ), intent(out) :: res exit flag, objective, iterations real(kind=wp), intent(out), optional :: lam (:) multipliers (size m ) public  subroutine daqp_quadprog (n, m, ms, bupper, blower, x, res, lam, H, f, A, sense, settings, break_points, problem_type, Rf, primal_start, dual_start) Set up and solve a problem in one call (upstream's daqp_quadprog : with the\ncheck of the unconstrained optimum, and the automatic elimination of\nequalities). Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: n number of variables integer(kind=ip), intent(in) :: m number of constraints (including the simple bounds) integer(kind=ip), intent(in) :: ms number of simple bounds real(kind=wp), intent(in) :: bupper (m) upper bounds real(kind=wp), intent(in) :: blower (m) lower bounds real(kind=wp), intent(out) :: x (n) the solution type( daqp_result ), intent(out) :: res exit flag, objective, iterations real(kind=wp), intent(out), optional :: lam (m) multipliers real(kind=wp), intent(in), optional :: H (n,n) Hessian (absent: an LP) real(kind=wp), intent(in), optional :: f (n) linear term real(kind=wp), intent(in), optional :: A (m-ms,n) constraint matrix integer(kind=ip), intent(in), optional :: sense (m) constraint flags type( daqp_settings ), intent(in), optional :: settings settings (default: upstream's) integer(kind=ip), intent(in), optional :: break_points (:) the last constraint of each level (hierarchical QP) integer(kind=ip), intent(in), optional :: problem_type daqp_problem_qp (default) or daqp_problem_avi real(kind=wp), intent(in), optional :: Rf (:) the Cholesky factor of H , packed by rows (instead of H ) real(kind=wp), intent(in), optional :: primal_start (n) a primal start real(kind=wp), intent(in), optional :: dual_start (m) a dual start public  subroutine daqp_avi (n, m, ms, H, f, bupper, blower, x, res, lam, A, sense, settings) Solve an affine variational inequality in one call (upstream's daqp_avi ):\nfind x with blower <= [x(1:ms); A x] <= bupper and (H x + f)'(y - x) >= 0 for all feasible y ( H need not be symmetric). Arguments Type Intent Optional Attributes Name integer(kind=ip), intent(in) :: n number of variables integer(kind=ip), intent(in) :: m number of constraints (including the simple bounds) integer(kind=ip), intent(in) :: ms number of simple bounds real(kind=wp), intent(in) :: H (n,n) the matrix of the AVI real(kind=wp), intent(in) :: f (n) linear term real(kind=wp), intent(in) :: bupper (m) upper bounds real(kind=wp), intent(in) :: blower (m) lower bounds real(kind=wp), intent(out) :: x (n) the solution type( daqp_result ), intent(out) :: res exit flag, iterations real(kind=wp), intent(out), optional :: lam (m) multipliers real(kind=wp), intent(in), optional :: A (m-ms,n) constraint matrix integer(kind=ip), intent(in), optional :: sense (m) constraint flags type( daqp_settings ), intent(in), optional :: settings settings public  subroutine daqp_primal_init_active (qp, x) Mark the constraints that are active at x (within 1e-9) as active in the\nconstraint flags of the problem, as a starting working set (upstream's daqp_primal_init_active ; nothing is done for a problem with binary\nconstraints, for which x is only used as an incumbent). Arguments Type Intent Optional Attributes Name type( daqp_problem ), intent(inout) :: qp the problem real(kind=wp), intent(in) :: x (:) primal iterate public  subroutine daqp_dual_init_active (qp, lam) Mark the constraints with a nonzero multiplier (beyond 1e-12) as active in\nthe constraint flags of the problem, as a starting working set (upstream's daqp_dual_init_active ). Arguments Type Intent Optional Attributes Name type( daqp_problem ), intent(inout) :: qp the problem real(kind=wp), intent(in) :: lam (:) dual iterate public  subroutine daqp_set_primal_start (work, x) Set the starting iterate (upstream's daqp_set_primal_start ); with binary\nconstraints, x is used as an incumbent if it is feasible. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace real(kind=wp), intent(in) :: x (:) iterate of the original problem public  subroutine daqp_minrep (A, b, ms, is_redundant, settings) Determine the redundant constraints of a polyhedron A x <= b (upstream's daqp_minrep ): the first ms constraints are x(1:ms) <= b(1:ms) , the\nothers A x <= b(ms+1:) . is_redundant(i) is 1 if constraint i is\nredundant, 0 otherwise. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: A (:,:) general constraints (m-ms,n) real(kind=wp), intent(in) :: b (:) right-hand sides (m) integer(kind=ip), intent(in) :: ms number of simple bounds integer(kind=ip), intent(out) :: is_redundant (:) (m) type( daqp_settings ), intent(in), optional :: settings settings private  subroutine minrep_work (work, is_redundant) Determine the redundant constraints of the LDP in the workspace (upstream's daqp_minrep_work ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(out) :: is_redundant (:) 1 if redundant, 0 otherwise private  subroutine allocate_avi (avi, n) Allocate the data of an AVI (upstream's allocate_daqp_avi ). Arguments Type Intent Optional Attributes Name type( daqp_avi_data ), intent(inout) :: avi AVI integer(kind=ip), intent(in) :: n number of variables private  subroutine daqp_lu_solve (LU, P, b, x, n) Solve A x = b with the factors of daqp_lu (upstream's daqp_lu_solve ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: LU (*) factors integer(kind=ip), intent(in) :: P (*) permutation real(kind=wp), intent(in) :: b (*) right-hand side real(kind=wp), intent(inout) :: x (*) solution integer(kind=ip), intent(in) :: n dimension private  subroutine update_avi (work) Set up the matrices of an AVI (upstream's daqp_update_avi ): the symmetric\npart, its shift by rho (Douglas-Rachford), and the LU factors of H . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine daqp_solve_avi_kkt (work) The KKT point of an AVI on the working set (upstream's daqp_solve_avi_kkt ): S lam = -A_W H&#94;{-1} f - b_W with S = A_W H&#94;{-1} A_W' , then H x = -f - A_W' lam . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace private  subroutine bnb_load_ws (work, ids, n_ids) Add the constraints in ids to the working set (aborted if the basis gets singular). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: ids (:) constraints (with the lower-bound bit) integer(kind=ip), intent(in) :: n_ids number of constraints private  subroutine spawn_children (work, node, branch_id) Replace a node by its two children. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: node node integer(kind=ip), intent(in) :: branch_id constraint to branch over private  subroutine node_cleanup_workspace (work, n_clean) Restore the working set to its first n_clean constraints. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: n_clean constraints to keep private  subroutine warmstart_node (work, node) Warm start a node: its fixed constraints, then its stored working set. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: node node private  subroutine save_warmstart (work, node) Store the working set of a node, as the warm start of its children. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: node node private  subroutine add_upper_lower (work, add_id) Add a constraint at its upper bound, or at its lower one if add_id has\nthe lower-bound bit. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: add_id constraint (with the lower-bound bit) private  subroutine setup_cold_bnb (work, node) Cold start a node: only its fixed constraints. Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace integer(kind=ip), intent(in) :: node node","tags":"","url":"module/daqp_core.html"},{"title":"daqp_module – daqp-fortran","text":"Object-oriented interface to the Fortran port of DAQP , a dual active-set solver for\n  dense convex quadratic programs: min  0.5 x'Hx + f'x\n  s.t. blower(1:ms)  <= x(1:ms) <= bupper(1:ms)\n       blower(ms+1:) <= A x     <= bupper(ms+1:) H must be symmetric positive definite, or positive semidefinite (then\n  a proximal-point outer loop is used); with no H , the problem is an LP.\n  Constraints can be equalities, soft, or binary (branch and bound); the\n  constraints can be split into levels of a hierarchical (lexicographic)\n  QP; and a nonsymmetric H defines an affine variational inequality (AVI). Multipliers The multipliers satisfy , with : when the upper bound\n  of row i is active, when its lower bound is active,\n  and 0 for an inactive row. daqp_lower_positive converts them to the\n  convention at a lower bound ( ).\n  For a hierarchical QP, lam holds the slacks of the soft levels instead. Example type ( daqp_type ) :: qp call qp % setup ( H , f , A , bupper , blower , istat ) call qp % solve ( x , lam , istat ) Uses daqp_types daqp_kinds daqp_core module~~daqp_module~~UsesGraph module~daqp_module daqp_module module~daqp_core daqp_core module~daqp_module->module~daqp_core modu