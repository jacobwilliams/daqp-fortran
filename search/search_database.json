t from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~minrep_work~~CalledByGraph proc~minrep_work minrep_work proc~daqp_minrep daqp_minrep proc~daqp_minrep->proc~minrep_work Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine minrep_work ( work , is_redundant ) type ( daqp_workspace ), intent ( inout ) :: work !! workspace integer ( ip ), intent ( out ) :: is_redundant (:) !! 1 if redundant, 0 otherwise integer ( ip ) :: i , j , exitflag is_redundant ( 1 : work % m ) = - 1 do i = 1 , work % m if ( is_redundant ( i ) /= - 1 . or . has ( work % sense ( i ), daqp_immutable )) cycle call daqp_reset_workspace ( work ) work % sense ( i ) = daqp_active + daqp_immutable call add_constraint ( work , i , 1.0_wp ) exitflag = daqp_ldp ( work ) if ( exitflag == daqp_exit_infeasible ) then is_redundant ( i ) = 1 work % sense ( i ) = iand ( work % sense ( i ), not ( daqp_active )) ! (remains immutable -> ignored) else is_redundant ( i ) = 0 work % sense ( i ) = iand ( work % sense ( i ), not ( daqp_immutable )) if ( exitflag == daqp_exit_optimal ) then do j = 1 , work % n_active ! all active constraints are also nonredundant is_redundant ( work % WS ( j )) = 0 end do end if end if call daqp_deactivate_constraints ( work ) end do end subroutine minrep_work","tags":"","url":"proc/minrep_work.html"},{"title":"allocate_avi – daqp-fortran","text":"private  subroutine allocate_avi(avi, n) Allocate the data of an AVI (upstream's allocate_daqp_avi ). Arguments Type Intent Optional Attributes Name type( daqp_avi_data ), intent(inout) :: avi AVI integer(kind=ip), intent(in) :: n number of variables Called by proc~~allocate_avi~~CalledByGraph proc~allocate_avi allocate_avi proc~daqp_setup daqp_setup proc~daqp_setup->proc~allocate_avi proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine allocate_avi ( avi , n ) type ( daqp_avi_data ), intent ( inout ) :: avi !! AVI integer ( ip ), intent ( in ) :: n !! number of variables avi % is_symmetric = . false . avi % retry_rho_needed = . false . avi % rho = 0.0_wp allocate ( avi % Hsym ( n , n ), avi % Hs_rho ( n , n ), avi % H_rho ( n , n ), avi % LU_H ( n , n ), & avi % P_H2 ( n ), avi % P_H ( n ), avi % P_S ( n ), avi % kkt_buffer ( n * n + 2 * n ), & avi % Hx ( n ), avi % x ( n ), avi % y ( n ), avi % xtemp ( n )) end subroutine allocate_avi","tags":"","url":"proc/allocate_avi.html"},{"title":"daqp_lu_solve – daqp-fortran","text":"private  subroutine daqp_lu_solve(LU, P, b, x, n) Solve A x = b with the factors of daqp_lu (upstream's daqp_lu_solve ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: LU (*) factors integer(kind=ip), intent(in) :: P (*) permutation real(kind=wp), intent(in) :: b (*) right-hand side real(kind=wp), intent(inout) :: x (*) solution integer(kind=ip), intent(in) :: n dimension Called by proc~~daqp_lu_solve~~CalledByGraph proc~daqp_lu_solve daqp_lu_solve proc~check_unconstrained check_unconstrained proc~check_unconstrained->proc~daqp_lu_solve proc~daqp_solve_avi daqp_solve_avi proc~daqp_solve_avi->proc~daqp_lu_solve proc~daqp_solve_avi->proc~daqp_solve_avi proc~daqp_solve_avi_kkt daqp_solve_avi_kkt proc~daqp_solve_avi->proc~daqp_solve_avi_kkt proc~daqp_solve_avi_kkt->proc~daqp_lu_solve proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_solve_avi proc~daqp_update_ldp daqp_update_ldp proc~daqp_solve->proc~daqp_update_ldp proc~update_ldp_core update_ldp_core proc~update_ldp_core->proc~check_unconstrained proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_solve proc~daqp_setup daqp_setup proc~daqp_quadprog->proc~daqp_setup proc~daqp_update_ldp->proc~update_ldp_core proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog proc~daqp_setup->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~setup daqp_type%setup proc~setup->proc~daqp_setup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine daqp_lu_solve ( LU , P , b , x , n ) real ( wp ), intent ( in ) :: LU ( * ) !! factors integer ( ip ), intent ( in ) :: P ( * ) !! permutation real ( wp ), intent ( in ) :: b ( * ) !! right-hand side real ( wp ), intent ( inout ) :: x ( * ) !! solution integer ( ip ), intent ( in ) :: n !! dimension integer ( ip ) :: i , j ! solve Ly = Pb do i = 0 , n - 1 x ( i + 1 ) = b ( P ( i + 1 )) do j = 0 , i - 1 x ( i + 1 ) = x ( i + 1 ) - LU ( i * n + j + 1 ) * x ( j + 1 ) end do end do ! solve Ux = y do i = n - 1 , 0 , - 1 do j = i + 1 , n - 1 x ( i + 1 ) = x ( i + 1 ) - LU ( i * n + j + 1 ) * x ( j + 1 ) end do x ( i + 1 ) = x ( i + 1 ) / LU ( i * n + i + 1 ) end do end subroutine daqp_lu_solve","tags":"","url":"proc/daqp_lu_solve.html"},{"title":"update_avi – daqp-fortran","text":"private  subroutine update_avi(work) Set up the matrices of an AVI (upstream's daqp_update_avi ): the symmetric\npart, its shift by rho (Douglas-Rachford), and the LU factors of H . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Calls proc~~update_avi~~CallsGraph proc~update_avi update_avi proc~daqp_lu daqp_lu proc~update_avi->proc~daqp_lu Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~update_avi~~CalledByGraph proc~update_avi update_avi proc~update_ldp_core update_ldp_core proc~update_ldp_core->proc~update_avi proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~update_ldp_core proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine update_avi ( work ) type ( daqp_workspace ), intent ( inout ) :: work !! workspace integer ( ip ) :: i , j , n , lu_status real ( wp ) :: val , min_diag , max_row_sum , fro_norm_sq , max_asymmetry , row_sum , & asymmetry , hessian_scale , min_lu_pivot , pivot n = work % qp % n associate ( avi => work % avi , H => work % qp % Hc ) min_diag = daqp_inf max_row_sum = 0.0_wp fro_norm_sq = 0.0_wp max_asymmetry = 0.0_wp avi % rho = 0.0_wp avi % retry_rho_needed = . false . do i = 1 , n row_sum = 0.0_wp do j = 1 , n if ( j > i ) then asymmetry = abs ( H ( j , i ) - H ( i , j )) if ( asymmetry > max_asymmetry ) max_asymmetry = asymmetry end if val = ( H ( j , i ) + H ( i , j )) * 0.5_wp avi % Hsym ( j , i ) = val avi % Hs_rho ( j , i ) = val avi % H_rho ( j , i ) = H ( j , i ) avi % LU_H ( j , i ) = H ( j , i ) if ( val < 0.0_wp ) then row_sum = row_sum - val else row_sum = row_sum + val end if fro_norm_sq = fro_norm_sq + H ( j , i ) * H ( j , i ) if ( i == j . and . val < min_diag ) min_diag = val end do if ( row_sum > max_row_sum ) max_row_sum = row_sum end do hessian_scale = sqrt ( fro_norm_sq ) if ( hessian_scale < 1.0_wp ) hessian_scale = 1.0_wp avi % is_symmetric = max_asymmetry <= work % settings % zero_tol * hessian_scale if ( avi % is_symmetric ) return ! detect a possibly problematic rho from the LU pivots lu_status = daqp_lu ( avi % LU_H , avi % P_H , n ) if ( lu_status == 0 . and . min_diag > 0.0_wp ) then min_lu_pivot = daqp_inf do i = 1 , n pivot = abs ( avi % LU_H ( i , i )) if ( pivot < min_lu_pivot ) min_lu_pivot = pivot end do if ( min_lu_pivot < avi_pivot_trigger * min_diag ) avi % retry_rho_needed = . true . end if ! start with the default step length heuristic if ( min_diag > 0.0_wp . and . max_row_sum > 0.0_wp ) then avi % rho = sqrt ( min_diag * max_row_sum ) else avi % rho = sqrt ( fro_norm_sq ) / 2.0_wp end if do i = 1 , n avi % Hs_rho ( i , i ) = avi % Hs_rho ( i , i ) + avi % rho avi % H_rho ( i , i ) = avi % H_rho ( i , i ) + avi % rho end do ! (the factorization of H_rho is deferred until needed) end associate end subroutine update_avi","tags":"","url":"proc/update_avi.html"},{"title":"daqp_solve_avi_kkt – daqp-fortran","text":"private  subroutine daqp_solve_avi_kkt(work) The KKT point of an AVI on the working set (upstream's daqp_solve_avi_kkt ): S lam = -A_W H&#94;{-1} f - b_W with S = A_W H&#94;{-1} A_W' , then H x = -f - A_W' lam . Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(inout) :: work workspace Calls proc~~daqp_solve_avi_kkt~~CallsGraph proc~daqp_solve_avi_kkt daqp_solve_avi_kkt proc~daqp_lu daqp_lu proc~daqp_solve_avi_kkt->proc~daqp_lu proc~daqp_lu_solve daqp_lu_solve proc~daqp_solve_avi_kkt->proc~daqp_lu_solve proc~has~2 has proc~daqp_solve_avi_kkt->proc~has~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~daqp_solve_avi_kkt~~CalledByGraph proc~daqp_solve_avi_kkt daqp_solve_avi_kkt proc~daqp_solve_avi daqp_solve_avi proc~daqp_solve_avi->proc~daqp_solve_avi_kkt proc~daqp_solve_avi->proc~daqp_solve_avi proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_solve_avi proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_solve proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine daqp_solve_avi_kkt ( work ) type ( daqp_workspace ), intent ( inout ) :: work !! workspace integer ( ip ) :: i , j , k , nAS , n , row_idx , roff , flag real ( wp ) :: s , lj nAS = work % n_active n = work % n roff = nAS * nAS ! the right-hand side follows S in kkt_buffer associate ( avi => work % avi , qp => work % qp , temp => work % avi % xtemp ) ! S = A_WS * H&#94;-1 * A_WS&#94;T do i = 0 , nAS - 1 ! temp = H&#94;-1 * A_row_WS(i)&#94;T row_idx = work % WS ( i + 1 ) if ( row_idx <= work % ms ) then ! simple bound avi % kkt_buffer ( roff + 1 : roff + n ) = 0.0_wp avi % kkt_buffer ( roff + row_idx ) = 1.0_wp call daqp_lu_solve ( avi % LU_H , avi % P_H , avi % kkt_buffer ( roff + 1 : roff + n ), temp , n ) else call daqp_lu_solve ( avi % LU_H , avi % P_H , qp % At (:, row_idx - work % ms ), temp , n ) end if do j = 0 , nAS - 1 row_idx = work % WS ( j + 1 ) if ( row_idx <= work % ms ) then ! simple bound s = temp ( row_idx ) else ! general constraint s = 0.0_wp do k = 1 , n s = s + qp % At ( k , row_idx - work % ms ) * temp ( k ) end do end if avi % kkt_buffer ( j * nAS + i + 1 ) = s end do end do ! the right-hand side: -A_WS * H&#94;-1 * f - b_WS call daqp_lu_solve ( avi % LU_H , avi % P_H , qp % f , temp , n ) do i = 0 , nAS - 1 row_idx = work % WS ( i + 1 ) if ( has ( work % sense ( row_idx ), daqp_lower )) then s = qp % blower ( row_idx ) else s = qp % bupper ( row_idx ) end if if ( row_idx <= work % ms ) then s = s + temp ( row_idx ) else do k = 1 , n s = s + qp % At ( k , row_idx - work % ms ) * temp ( k ) end do end if avi % kkt_buffer ( roff + i + 1 ) = - s ! soft constraints -> the diagonal of S is regularized if ( has ( work % sense ( row_idx ), daqp_soft )) then avi % kkt_buffer ( i * ( nAS + 1 ) + 1 ) = avi % kkt_buffer ( i * ( nAS + 1 ) + 1 ) + & work % settings % rho_soft / ( work % scaling ( row_idx ) * work % scaling ( row_idx )) end if end do ! lambda: S * lambda = rhs flag = daqp_lu ( avi % kkt_buffer , avi % P_S , nAS ) call daqp_lu_solve ( avi % kkt_buffer , avi % P_S , avi % kkt_buffer ( roff + 1 : roff + nAS ), work % lam_star , nAS ) ! x: H * x = -f - A_WS&#94;T * lambda do i = 1 , n temp ( i ) = - qp % f ( i ) end do do j = 1 , nAS lj = work % lam_star ( j ) row_idx = work % WS ( j ) if ( row_idx <= work % ms ) then temp ( row_idx ) = temp ( row_idx ) - lj else do i = 1 , n temp ( i ) = temp ( i ) - qp % At ( i , row_idx - work % ms ) * lj end do end if end do call daqp_lu_solve ( avi % LU_H , avi % P_H , temp , avi % x , n ) end associate end subroutine daqp_solve_avi_kkt","tags":"","url":"proc/daqp_solve_avi_kkt.html"},{"title":"bnb_load_ws – daqp-fortran","text":"private  subroutine bnb_load_ws(work, ids, n_ids) Add the constraints in ids to t