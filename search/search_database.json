 ( k ) = p ( k ) + B ( k , i ) * vi end if p ( i ) = p ( i ) + s end do do i = k , n p ( i ) = p ( i ) * tk pv = pv + p ( i ) * vk ( i ) end do ! w = p - (tk/2)(p'v) v, B <-- B - v w' - w v' pv = pv * ( 0.5_wp * tk ) do i = k , n p ( i ) = p ( i ) - pv * vk ( i ) end do do i = k , n vi = vk ( i ) wi = p ( i ) B ( k , i ) = B ( k , i ) - ( vi * p ( k ) + wi ) do j = k + 1 , i B ( j , i ) = B ( j , i ) - ( vi * p ( j ) + wi * V ( j , k )) end do end do end do contains pure real ( wp ) function vk ( ii ) !! element `ii` of reflector `k` (1 at `k`) integer ( ip ), intent ( in ) :: ii if ( ii == k ) then vk = 1.0_wp else vk = V ( ii , k ) end if end function vk end subroutine eq_twoside","tags":"","url":"proc/eq_twoside.html"},{"title":"eq_trsm_rows – daqp-fortran","text":"private  subroutine eq_trsm_rows(L, nz, X, cnt) Rows X(:,r) <-- X(:,r) L&#94;{-T} (solves L x' = x' ), for cnt rows\n( L lower, row major: L(k,j) , k <= j ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: L (:,:) Cholesky factor integer(kind=ip), intent(in) :: nz dimension real(kind=wp), intent(inout) :: X (:,:) rows (columns of X) integer(kind=ip), intent(in) :: cnt number of rows Called by proc~~eq_trsm_rows~~CalledByGraph proc~eq_trsm_rows eq_trsm_rows proc~eq_build_reduction eq_build_reduction proc~eq_build_reduction->proc~eq_trsm_rows proc~daqp_eq_update daqp_eq_update proc~daqp_eq_update->proc~eq_build_reduction proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~daqp_eq_update proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes o