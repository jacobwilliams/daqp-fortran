ger ( ip ), intent ( in ) :: n_eq !! number of equality candidates integer ( ip ) :: n , n_ineq n = work % qp % n n_ineq = work % qp % m - work % qp % ms - n_eq eq_is_worthwhile = . true . if ( n_eq >= n ) return eq_is_worthwhile = . false . if ( n < eq_min_dim . or . n_eq <= eq_min_count . or . eq_min_ratio * n_eq <= n ) return if ( eq_is_diagonal ( work % qp , work % settings % zero_tol ) . and . & ( n_ineq == 0 . or . eq_diag_min_ratio * n_eq < n )) return eq_is_worthwhile = . true . end function eq_is_worthwhile","tags":"","url":"proc/eq_is_worthwhile.html"},{"title":"daqp_eq_wanted – daqp-fortran","text":"public  function daqp_eq_wanted(work, mask) Whether the problem in the workspace is to be reduced for an update with mask ( settings%eq_reduction ; auto only with daqp_update_eliminate ). Arguments Type Intent Optional Attributes Name type( daqp_workspace ), intent(in) :: work workspace integer(kind=ip), intent(in) :: mask update mask Return Value logical Calls proc~~daqp_eq_wanted~~CallsGraph proc~daqp_eq_wanted daqp_eq_wanted proc~eq_count_candidates eq_count_candidates proc~daqp_eq_wanted->proc~eq_count_candidates proc~eq_is_worthwhile eq_is_worthwhile proc~daqp_eq_wanted->proc~eq_is_worthwhile proc~has~2 has proc~daqp_eq_wanted->proc~has~2 proc~is_hierarchical is_hierarchical proc~daqp_eq_wanted->proc~is_hierarchical proc~eq_is_candidate eq_is_candidate proc~eq_count_candidates->proc~eq_is_candidate proc~eq_is_diagonal eq_is_diagonal proc~eq_is_worthwhile->proc~eq_is_diagonal proc~eq_is_candidate->proc~has~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~daqp_eq_wanted~~CalledByGraph proc~daqp_eq_wanted daqp_eq_wanted proc~daqp_update_ldp daqp_update_ldp proc~daqp_update_ldp->proc~daqp_eq_wanted proc~daqp_setup daqp_setup proc~daqp_setup->proc~daqp_update_ldp proc~daqp_solve daqp_solve proc~daqp_solve->proc~daqp_update_ldp proc~update daqp_type%update proc~update->proc~daqp_update_ldp proc~daqp_quadprog daqp_quadprog proc~daqp_quadprog->proc~daqp_setup proc~daqp_quadprog->proc~daqp_solve proc~setup daqp_type%setup proc~setup->proc~daqp_setup proc~solve daqp_type%solve proc~solve->proc~daqp_solve proc~daqp_avi daqp_avi proc~daqp_avi->proc~daqp_quadprog Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code logical function daqp_eq_wanted ( work , mask ) type ( daqp_workspace ), intent ( in ) :: work !! workspace integer ( ip ), intent ( in ) :: mask !! update mask integer ( ip ) :: n_eq , policy daqp_eq_wanted = . false . policy = work % settings % eq_reduction if ( policy == daqp_eq_reduction_off ) return if ( policy /= daqp_eq_reduction_on . and . . not . has ( mask , daqp_update_eliminate )) return if ( work % qp % m <= work % qp % ms ) return ! a hierarchy refers to the constraints by their index, and a factored ! Hessian is not available as a Hessian if ( work % qp % nh > 1 . or . is_hierarchical ( work ) . or . & work % qp % problem_type == daqp_problem_factored ) return n_eq = eq